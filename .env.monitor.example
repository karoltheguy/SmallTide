# SmallTide configuration — MONITOR ON GPU (monitor cable ON the RX 9070 XT).
# Do not use this `.example` file directly — copy it first:
#   copy .env.monitor.example .env.monitor
#   .\smalltide.cmd serve .env.monitor
# If your monitor is on the CPU iGPU / motherboard instead, copy `.env.headless.example` instead.
#
# Windows display tip: assign Edge / Chromium / Electron chat clients to "Power saving (iGPU)" in
# Windows Settings -> System -> Display -> Graphics (or disable browser hardware acceleration).
# That prevents AMD D3D11/MPO visual tile glitches and stops UI repaints from stealing 9070 XT cycles.

# --- Model & context -------------------------------------------------------------------------
SMALLTIDE_MODEL_DIR=models/Inkling-2-Mini
# Elastic 128K context: all 40 local + 8 global + DFlash 2 layers share one compact 32K paged KV
# pool (leaving maximum VRAM for resident experts on normal turns), dynamically growing up to 128K
# on long prompts, then shrinking back. Extra lanes cost only ~3.7 MiB VRAM and 0 extra host RAM.
SMALLTIDE_MAX_CTX=131072
SMALLTIDE_KV_FMT=k8v4
# Dense weight precision: fp8 (~1.10 GiB, default for 16 GB) or bf16 (~2.20 GiB, exact native checkpoint).
# SMALLTIDE_DENSE_FMT=fp8
SMALLTIDE_LANES=4
SMALLTIDE_MAX_TOKENS=131072
SMALLTIDE_KV_TOKENS=131072
SMALLTIDE_KV_INITIAL_TOKENS=32768
# Idle seconds before an expanded elastic KV pool offloads blocking idle lanes to RAM prefix cache
# and shrinks back to SMALLTIDE_KV_INITIAL_TOKENS (default 300s; 0 = disable idle shrink).
# SMALLTIDE_KV_IDLE_SHRINK_SECS=300

# --- Expert residency (TideLM) ----------------------------------------------------------------
SMALLTIDE_NVFP4_SLOTS=auto
SMALLTIDE_MXFP8_SLOTS=auto
SMALLTIDE_MXFP8_HOST=off
SMALLTIDE_POOL_BUDGET=resident
# Extra safety margin for DWM/desktop apps on the display GPU (fit_pools_to_resident also frees any
# slow spilled tail back to WDDM).
SMALLTIDE_RESIDENT_MARGIN_MB=768
SMALLTIDE_RESIDENT_TAIL_MB=512
# Keep system RAM headroom so Windows desktop apps don't page to SSD.
SMALLTIDE_RAM_GB=10

# --- Inline miss rescue & swap tuning ---------------------------------------------------------
SMALLTIDE_RESCUE_MODE=threshold
SMALLTIDE_RESCUE_THRESHOLD=0.10
SMALLTIDE_RESCUE_THRESHOLD_CORE=0.08
# Always rescue dominant missing experts (>= 25% share) regardless of budget/auto-gate (0 = off).
SMALLTIDE_RESCUE_MUST_THRESHOLD=0.25
SMALLTIDE_RESCUE_WAIT=spin
SMALLTIDE_RESCUE_AUTO_GATE=1
SMALLTIDE_RESCUE_AUTO_MIN=0.10
SMALLTIDE_RESCUE_BUDGET_PRELUDE=18
SMALLTIDE_RESCUE_BUDGET_CORE=18
SMALLTIDE_RESCUE_BUDGET_CODA=22
# Compact rescue rings return ~470 MiB to the heat-managed resident expert pools.
SMALLTIDE_RESCUE_RING_MXFP8=8
SMALLTIDE_RESCUE_RING_NVFP4=8
# Faster promotion into permanent resident slots via rescues and post-prefill rebalance.
SMALLTIDE_SWAP_HYSTERESIS=1.05
# Exact full-row rescues on speculative verify (set 1 to trade a little quality for extra tok/s).
SMALLTIDE_SPEC_ROW_DECAY=0
# Disable decode-time background/periodic promotions (set > 0 to re-enable).
SMALLTIDE_ASYNC_PER_TOKEN=0
SMALLTIDE_PERIODIC_REBALANCE_SWAPS=0

# --- Prefill, speculative decoding & prefix cache ---------------------------------------------
SMALLTIDE_PREFILL=batched
# Reclaim ~550+ MiB VRAM from prefill scratch vs 1024/all so more experts stay resident on the display card.
SMALLTIDE_PREFILL_CHUNK=256
SMALLTIDE_ATTN_VTILES=local
SMALLTIDE_SPEC=1
# Drafter backend: auto (DFlash 2 if models/Inkling-2-Mini-DFlash2 is present, else DSpark), dflash2, or dspark.
SMALLTIDE_DRAFTER=auto
# SMALLTIDE_DFLASH2_DIR=models/Inkling-2-Mini-DFlash2
# Compact non-pageable pinned prefix cache (4 snapshots within 128K tokens).
SMALLTIDE_PREFIX_SNAPSHOTS=4
SMALLTIDE_PREFIX_TOKENS=131072

# --- Server -----------------------------------------------------------------------------------
SMALLTIDE_HOST=0.0.0.0
SMALLTIDE_PORT=8000
# Repetition loop detector (1 = on, 0 = off): force-exits thinking loops into a clean answer, or hard-stops text loops.
# SMALLTIDE_LOOP_DETECT=1
