# SmallTide configuration. Copy to `.env` (read from the working directory, or SMALLTIDE_ENV=path).
# Variables already set in the process environment override this file, e.g.
#   SMALLTIDE_RESCUE_MODE=exact smalltide-cli run -p "..."
# Per-request inputs stay on the command line: `run -p <prompt> [-n N] [--temp T] [--effort E] [--raw]`.

# --- Model & context -------------------------------------------------------------------------
SMALLTIDE_MODEL_DIR=models/Inkling-2-Mini
# Global-attention KV capacity in tokens (local layers always keep a 1024-token window).
SMALLTIDE_MAX_CTX=16384

# --- Expert residency (TideLM) ----------------------------------------------------------------
# Device pool slots: `auto` sizes from free device memory (loop core first, then the rest of NVFP4).
SMALLTIDE_NVFP4_SLOTS=auto
SMALLTIDE_MXFP8_SLOTS=auto
# MXFP8 pool in pinned host memory holding all 512 MXFP8 experts (zero-copy over PCIe):
# auto = when the device pool cannot hold them all; on | off.
SMALLTIDE_MXFP8_HOST=auto
# Bound for `auto` pool sizing: device (HIP free memory; on Windows part of it may silently be
# system RAM read over PCIe) | resident (only what stays on the card: dedicated VRAM minus what
# other processes hold resident, capped by the DXGI budget; misses are skipped or rescued per
# SMALLTIDE_RESCUE_MODE).
SMALLTIDE_POOL_BUDGET=device
# Resident sizing safety margin (MiB) left free after pools + KV + scratch. Overshooting the
# resident amount even slightly puts pool pages in system memory (~10x slower reads).
# SMALLTIDE_RESIDENT_MARGIN_MB=768
# Radeon 26.5.1-26.9.1 capped residency near half the card (KMD bug, ROCm/TheRock#7221); on those
# drivers use the old DXGI-reservation estimate instead:
# SMALLTIDE_RESIDENT_CAP=reservation
# HIP device index (default: the discrete GPU with the most memory; device order changes
# between driver versions, an integrated Radeon can be device 0).
# SMALLTIDE_HIP_DEVICE=1
# Host RAM tier for experts not in a pool (GiB).
SMALLTIDE_RAM_GB=10
# What to do with a routed expert that is not resident: exact (copy it in, always),
# threshold (copy only if its routing share >= SMALLTIDE_RESCUE_THRESHOLD, else skip + renormalize),
# disabled (always skip).
SMALLTIDE_RESCUE_MODE=threshold
SMALLTIDE_RESCUE_THRESHOLD=0.25

# --- Adaptive expert placement ---------------------------------------------------------------
# Routing priors: per-layer routing-share history, one vote per request (prompt + answer), saved
# after every request. They drive the value-per-byte split of the resident budget between the
# NVFP4 and MXFP8 pools, which experts the warm-up loads, and a floor on eviction values.
# Default file: <SMALLTIDE_MODEL_DIR>/tide_priors.json; `off` disables priors.
# SMALLTIDE_PRIORS=models/Inkling-2-Mini/tide_priors.json
# Fold requests into the priors (0 = frozen, e.g. for benchmarks). `serve` learns by default;
# `run` (dev / benchmarks) only when this is set explicitly.
# SMALLTIDE_PRIORS_UPDATE=1
# Prompt-aware loading (async swaps): before a request from its conversation's remembered routing
# (prefix-cache snapshot / lane), and between prefill chunks from the prompt's routing so far.
# SMALLTIDE_ANTICIPATE_SWAPS=256
# SMALLTIDE_PREFILL_CHUNK_SWAPS=96
# SMALLTIDE_ANTICIPATE_WAIT=0
# Weight of the newest request once history exists (half-life ~ ln2 / value requests).
# SMALLTIDE_PRIORS_NEWEST=0.1
# Prior weight in expert values, in heat half-lives (0 = session heat only).
# SMALLTIDE_PRIOR_WEIGHT=1.0
# Decode-time async promotion: a missed expert must be worth this many times the coldest resident
# it would evict; at most this many promotions per token.
# SMALLTIDE_ASYNC_HYSTERESIS=1.25
# SMALLTIDE_ASYNC_PER_TOKEN=2
# Prefill with SMALLTIDE_RESCUE_MODE=threshold: stage a missing expert only if its summed routing
# share over a 128-token chunk is at least this many tokens' worth (else skip + renormalize).
# exact stages everything; disabled stages nothing.
# SMALLTIDE_PREFILL_MIN_SHARE=1.0
# Measure pool residency (copy bandwidth per 256 MiB window) also outside the resident budget mode.
# SMALLTIDE_POOL_CHECK=1

# Speed profile (quality traded for tok/s): only on-card experts, missed experts skipped with no
# per-layer host sync:
#   SMALLTIDE_POOL_BUDGET=resident
#   SMALLTIDE_MXFP8_HOST=off
#   SMALLTIDE_RESCUE_MODE=disabled

# --- Prefill / server -------------------------------------------------------------------------
# batched (128-token chunks) | token (legacy one-token-at-a-time)
SMALLTIDE_PREFILL=batched
# Concurrent requests served at once (lanes; extra requests queue). Lane 0 has SMALLTIDE_MAX_CTX,
# the others SMALLTIDE_LANE_CTX; each lane's KV comes out of the expert-pool budget
# (~0.1 GiB rings + ~17 KB per context token).
# Each extra lane's KV comes out of the expert pools: in the speed profile 1 lane -> 4 lanes cost
# ~190 NVFP4 slots (skipped decode routing weight 2.7% -> 4.1%). Use 1 for best single-stream quality.
# SMALLTIDE_LANES=4
# SMALLTIDE_LANE_CTX=8192
# Batched decode: with several active requests, one pass per round over all of them (weights
# read once; routed experts shared across rows are dequantized once). Misses are skipped in
# batched rounds (no rescue copies). 0 = interleave single-row steps instead.
# SMALLTIDE_BATCH_DECODE=1
# Server prompt prefix cache: at most this many snapshots / prefix tokens in pinned host RAM
# (each snapshot: ~96 MiB of sliding-window KV rings + ~17 KB per prefix token of global KV).
# A request can opt out with `"cache_prompt": false`.
# SMALLTIDE_PREFIX_SNAPSHOTS=12
# SMALLTIDE_PREFIX_TOKENS=65536
SMALLTIDE_HOST=0.0.0.0
SMALLTIDE_PORT=8000

# --- Diagnostics (leave unset normally) ---------------------------------------------------------
# SMALLTIDE_PROFILE=1          # per-section decode timing with syncs (slow)
# SMALLTIDE_SEGTIME=1          # GPU timeline segments per token (reliable breakdown)
# SMALLTIDE_KTIMING=1          # per-kernel event timing (WDDM inflates each kernel ~40 us)
# SMALLTIDE_DUMP_DIR=dump      # per-token layer dumps for tools/inkling2_loop_ref.py
# SMALLTIDE_PREFIX_DEBUG=1     # log prefix-cache decisions in the server
# SMALLTIDE_BENCH_MOE=1        # MoE timing per expert-pool region at `run` startup
