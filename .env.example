# SmallTide configuration. Copy to `.env` (read from the working directory, next to
# `smalltide-cli.exe`, or SMALLTIDE_ENV=path).
# Variables already set in the process environment override this file, e.g.:
#   $env:SMALLTIDE_RESCUE_MODE="exact"; .\smalltide.ps1 run -p "Hello"
#
# Defaults below are tuned for an AMD Radeon RX 9070 XT (16 GB) on Windows 11 with
# Adrenalin 26.10.44+ (128K shared paged K8/V4 KV across 2 lanes + ~1,900-1,960 resident experts + DSpark spec).

# --- Model & context -------------------------------------------------------------------------
SMALLTIDE_MODEL_DIR=models/Inkling-2-Mini
# Maximum single-sequence context in tokens (local layers always keep a 1024-token ring).
SMALLTIDE_MAX_CTX=131072
# Shared paged global-KV pool across all lanes.
SMALLTIDE_KV_TOKENS=131072
# Global KV format:
#   k8v4 = FP8 E4M3 keys + per-32-group asymmetric INT4 values (~472 MiB saved at 128K; recommended)
#   fp8  = FP8 E4M3 keys + FP8 E4M3 values
SMALLTIDE_KV_FMT=k8v4
# Default output token limit when an API request omits `max_tokens` (still bounded by context).
SMALLTIDE_MAX_TOKENS=131072

# --- Expert residency (TideLM) ----------------------------------------------------------------
# Device pool slots: `auto` sizes from the measured on-card resident VRAM budget.
SMALLTIDE_NVFP4_SLOTS=auto
SMALLTIDE_MXFP8_SLOTS=auto
# Keep MXFP8 experts on-card via the resident pool (`off`) instead of PCIe host-mapped (`on`).
SMALLTIDE_MXFP8_HOST=off
# Bound for `auto` pool sizing:
#   resident = only what stays in dedicated GDDR6 VRAM (DXGI budget + bandwidth probe; recommended)
#   device   = HIP free memory (on Windows, excess allocations silently spill to slow system RAM)
SMALLTIDE_POOL_BUDGET=resident
# Safety margins (MiB) kept free so WDDM never demotes dense weights, KV, or pool chunks.
SMALLTIDE_RESIDENT_MARGIN_MB=768
SMALLTIDE_RESIDENT_TAIL_MB=384
# Adrenalin 26.5.1-26.9.1 capped residency near half the card (ROCm/TheRock#7221); on those
# older drivers uncomment the line below:
# SMALLTIDE_RESIDENT_CAP=reservation
# HIP device index (default: auto-selects the discrete GPU with the most VRAM).
# SMALLTIDE_HIP_DEVICE=1
# Host RAM tier (GiB) holding non-VRAM experts so misses rescue over PCIe (~17 GB/s) instead of NVMe.
SMALLTIDE_RAM_GB=16

# --- Inline miss rescue -----------------------------------------------------------------------
# What to do when a routed expert is not in VRAM:
#   threshold = rescue only if routing weight >= threshold (else skip + renormalize; recommended)
#   exact     = always copy every missed expert before MoE (highest fidelity, lower tok/s)
#   disabled  = never rescue inline (fastest, relies solely on async promotion)
SMALLTIDE_RESCUE_MODE=threshold
SMALLTIDE_RESCUE_THRESHOLD=0.12
# Stricter threshold for Loop Core layers (executed 4x per token).
SMALLTIDE_RESCUE_THRESHOLD_CORE=0.05
# Per-token rescue budget split across Prelude / Loop Core / Coda:
SMALLTIDE_RESCUE_BUDGET=36
SMALLTIDE_RESCUE_BUDGET_PRELUDE=12
SMALLTIDE_RESCUE_BUDGET_CORE=9
SMALLTIDE_RESCUE_BUDGET_CODA=15
# GPU-side synchronization for inline rescues:
#   spin      = fused HIP spin-wait + route patch kernel (default, stable & zero host stall)
#   waitvalue = ROCm hipStreamWaitValue32
#   0         = host sync fallback
SMALLTIDE_RESCUE_WAIT=spin

# --- Speculative decoding (DSpark drafter, mtp.safetensors) ----------------------------------
# 1 enables the 3-layer DSpark drafter (~418 MiB VRAM @ 49K ctx) in `run` and single-lane `serve`
# for both greedy (temperature=0) and stochastic (temperature>0) sampling (exact rejection sampling).
SMALLTIDE_SPEC=1
# Fix verify width (2..=8); unset = adaptive confidence-gated draft width.
# SMALLTIDE_SPEC_WIDTH=6

# --- Adaptive expert placement & routing priors ----------------------------------------------
# Routing priors: per-layer routing-share history saved to <SMALLTIDE_MODEL_DIR>/tide_priors.json.
# On a fresh install, SmallTide automatically seeds from `profiles/inkling2-mini-priors.json`
# (aggregate routing floats only) and adapts to your traffic from there. Set `off` to disable.
# SMALLTIDE_PRIORS=models/Inkling-2-Mini/tide_priors.json
# SMALLTIDE_PRIORS_SEED=profiles/inkling2-mini-priors.json
# Set to 0 to freeze priors during controlled benchmarks (`serve` updates by default).
# SMALLTIDE_PRIORS_UPDATE=1
# Prompt-aware async swaps before a request and between prefill chunks:
# SMALLTIDE_ANTICIPATE_SWAPS=256
# SMALLTIDE_PREFILL_CHUNK_SWAPS=96
# SMALLTIDE_ANTICIPATE_WAIT=0
# Prior learning rate and weight:
# SMALLTIDE_PRIORS_NEWEST=0.1
# SMALLTIDE_PRIOR_WEIGHT=1.0
# Decode-time background promotion hysteresis and cap:
# SMALLTIDE_ASYNC_HYSTERESIS=1.25
# SMALLTIDE_ASYNC_PER_TOKEN=2
# Prefill rescue threshold (summed routing weight over a prefill chunk, in tokens' worth):
# SMALLTIDE_PREFILL_MIN_SHARE=1.0
# SMALLTIDE_POOL_CHECK=1

# --- Prefill / server -------------------------------------------------------------------------
# batched (chunks of SMALLTIDE_PREFILL_CHUNK tokens) | token (legacy single-token prefill)
SMALLTIDE_PREFILL=batched
# Tokens per prefill chunk (64 to 1024). Larger chunks read prompts faster and skip less routing
# weight, for more scratch VRAM: 512 holds about 150 MB more than 256 (a few dozen resident
# experts), 1024 about 450 MB more. Changing it starts a new disk prefix store.
# SMALLTIDE_PREFILL_CHUNK=512
# Concurrent serving lanes (all lanes share the SMALLTIDE_KV_TOKENS paged pool).
SMALLTIDE_LANES=2
# SMALLTIDE_LANE_CTX=8192
# SMALLTIDE_BATCH_DECODE=1
# Prompt prefix cache in pinned host RAM (opt out per request with `"cache_prompt": false`):
SMALLTIDE_PREFIX_SNAPSHOTS=4
SMALLTIDE_PREFIX_TOKENS=196608
SMALLTIDE_HOST=0.0.0.0
SMALLTIDE_PORT=8000

# --- Diagnostics (leave unset normally) -------------------------------------------------------
# SMALLTIDE_PROFILE=1          # per-section decode timing with syncs (slow)
# SMALLTIDE_SEGTIME=1          # GPU timeline segments per token
# SMALLTIDE_KTIMING=1          # per-kernel event timing
# SMALLTIDE_DUMP_DIR=dump      # per-token layer dumps for tools/inkling2_loop_ref.py
# SMALLTIDE_PREFIX_DEBUG=1     # log prefix-cache decisions in the server
# SMALLTIDE_BENCH_MOE=1        # MoE timing per expert-pool region at `run` startup

# Image input (PNG / JPEG parts in chat requests): the vision tower is streamed from the checkpoint
# per image, nothing of it stays in RAM or VRAM. 0 turns it off; MAX_TOKENS caps one image
# (one token is a 40 x 40 px cell; larger images are scaled down).
# SMALLTIDE_VISION=1
# SMALLTIDE_VISION_MAX_TOKENS=1536

# Prompt prefixes on disk: a conversation's next turn after a server restart, or after its
# snapshot left RAM, is read back instead of prefilled (a 5.8K-token prompt: 0.05 s instead of
# ~10 s). A saved segment is about 15 KB a position plus ~110 MB at its end; segments shorter than
# MIN new positions are not written, and the least recently used go first over the GB budget.
# Set SMALLTIDE_PREFIX_DISK=0 to never write prompt state to the SSD.
# SMALLTIDE_PREFIX_DISK=1
# SMALLTIDE_PREFIX_DISK_GB=16
# SMALLTIDE_PREFIX_DISK_MIN=256
# SMALLTIDE_PREFIX_DIR=models/Inkling-2-Mini/prefix_cache
