# SmallTide configuration. Copy to `.env` (read from the working directory, or SMALLTIDE_ENV=path).
# Variables already set in the process environment override this file, e.g.
#   SMALLTIDE_RESCUE_MODE=exact smalltide-cli run -p "..."
# Per-request inputs stay on the command line: `run -p <prompt> [-n N] [--temp T] [--effort E] [--raw]`.

# --- Model & context -------------------------------------------------------------------------
SMALLTIDE_MODEL_DIR=models/Inkling-2-Mini
# Global-attention KV capacity in tokens (local layers always keep a 1024-token window).
SMALLTIDE_MAX_CTX=16384

# --- Expert residency (TideLM) ----------------------------------------------------------------
# Device pool slots: `auto` sizes from free device memory (loop core first, then the rest of NVFP4).
SMALLTIDE_NVFP4_SLOTS=auto
SMALLTIDE_MXFP8_SLOTS=auto
# MXFP8 pool in pinned host memory holding all 512 MXFP8 experts (zero-copy over PCIe):
# auto = when the device pool cannot hold them all; on | off.
SMALLTIDE_MXFP8_HOST=auto
# Bound for `auto` pool sizing: device (HIP free memory; on Windows part of it may silently be
# system RAM read over PCIe) | resident (only what stays on the card: dedicated VRAM minus what
# other processes hold resident, capped by the DXGI budget; misses are skipped or rescued per
# SMALLTIDE_RESCUE_MODE).
SMALLTIDE_POOL_BUDGET=device
# Resident sizing safety margin (MiB) left free after pools + KV + scratch. Overshooting the
# resident amount even slightly puts pool pages in system memory (~10x slower reads).
# SMALLTIDE_RESIDENT_MARGIN_MB=768
# Radeon 26.5.1-26.9.1 capped residency near half the card (KMD bug, ROCm/TheRock#7221); on those
# drivers use the old DXGI-reservation estimate instead:
# SMALLTIDE_RESIDENT_CAP=reservation
# HIP device index (default: the discrete GPU with the most memory; device order changes
# between driver versions, an integrated Radeon can be device 0).
# SMALLTIDE_HIP_DEVICE=1
# Host RAM tier for experts not in a pool (GiB).
SMALLTIDE_RAM_GB=10
# What to do with a routed expert that is not resident: exact (copy it in, always),
# threshold (copy only if its routing share >= SMALLTIDE_RESCUE_THRESHOLD, else skip + renormalize),
# disabled (always skip).
SMALLTIDE_RESCUE_MODE=threshold
SMALLTIDE_RESCUE_THRESHOLD=0.25

# Speed profile (quality traded for tok/s): only on-card experts, missed experts skipped with no
# per-layer host sync:
#   SMALLTIDE_POOL_BUDGET=resident
#   SMALLTIDE_MXFP8_HOST=off
#   SMALLTIDE_RESCUE_MODE=disabled

# --- Prefill / server -------------------------------------------------------------------------
# batched (128-token chunks) | token (legacy one-token-at-a-time)
SMALLTIDE_PREFILL=batched
SMALLTIDE_HOST=0.0.0.0
SMALLTIDE_PORT=8000

# --- Diagnostics (leave unset normally) ---------------------------------------------------------
# SMALLTIDE_PROFILE=1          # per-section decode timing with syncs (slow)
# SMALLTIDE_SEGTIME=1          # GPU timeline segments per token (reliable breakdown)
# SMALLTIDE_KTIMING=1          # per-kernel event timing (WDDM inflates each kernel ~40 us)
# SMALLTIDE_DUMP_DIR=dump      # per-token layer dumps for tools/inkling2_loop_ref.py
# SMALLTIDE_PREFIX_DEBUG=1     # log prefix-cache decisions in the server
# SMALLTIDE_BENCH_MOE=1        # MoE timing per expert-pool region at `run` startup
