# Docker Compose settings for docker/compose.yaml. Copy to docker/.env and uncomment what you need:
#   cp docker/.env.example docker/.env
#
# This file is read by Compose, not by SmallTide. The engine's own configuration (model directory,
# KV cache, rescue tuning, ...) is the .env inside the data volume, created on first start from
# .env.headless.example or .env.monitor.example; edit that one to tune the engine.

# Template for the engine .env on first start (ignored once /data/.env exists):
#   headless  monitor on the motherboard or another GPU
#   monitor   monitor plugged into the Radeon card (leaves VRAM for the desktop)
#SMALLTIDE_CONFIG=headless

# Address the port is published on. 127.0.0.1 keeps it on this machine. 0.0.0.0 opens it to your
# network: the API has no authentication, so only do that on a trusted network or behind a reverse
# proxy that checks credentials. Docker's port rules bypass firewalld and ufw.
#SMALLTIDE_BIND=127.0.0.1

# Host port.
#SMALLTIDE_PORT=8000

# Absolute host directory for the engine .env, the model (about 21 GB) and the routing priors.
# Default: the named volume smalltide-data. To reuse a model you already have, put this directory's
# models/Inkling-2-Mini (and models/Inkling-2-Mini-DFlash2) there.
#SMALLTIDE_DATA=/path/to/smalltide

# Supplementary group that grants GPU access: video for Docker and rootful Podman,
# keep-groups for rootless Podman.
#SMALLTIDE_GROUP=video

# Image to run (or the tag given to an `up --build` image).
#SMALLTIDE_IMAGE=ghcr.io/karoltheguy/smalltide:latest

# Optional, for higher Hugging Face rate limits on the first-start download.
#HF_TOKEN=
