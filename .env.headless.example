# SmallTide configuration — HEADLESS GPU (monitor cable OFF the RX 9070 XT, e.g. on CPU iGPU).
# Do not use this `.example` file directly — copy it first:
#   copy .env.headless.example .env.headless
#   .\smalltide.cmd serve .env.headless
# (Or copy it to `.env` for default `.\smalltide.cmd serve` / `run`.)
# If your monitor cable IS connected to the RX 9070 XT, copy `.env.monitor.example` instead.
# Variables already set in the process environment override this file, e.g.:
#   $env:SMALLTIDE_RESCUE_MODE="exact"; .\smalltide.ps1 run -p "Hello"
#
# Defaults below are tuned for an AMD Radeon RX 9070 XT (16 GB) on Windows 11 with
# Adrenalin 26.10.44+ (elastic 128K shared paged K8/V4 KV starting at 32K + DSpark spec).

# --- Model & context -------------------------------------------------------------------------
SMALLTIDE_MODEL_DIR=models/Inkling-2-Mini
# Maximum single-sequence context in tokens (local layers always keep a 1024-token ring).
SMALLTIDE_MAX_CTX=131072
# Shared paged global-KV pool ceiling across all lanes.
SMALLTIDE_KV_TOKENS=131072
# Elastic KV: start at 32K in VRAM (maximizing resident experts on normal turns) and grow on demand
# up to SMALLTIDE_KV_TOKENS by borrowing tail NVFP4 slots on long prompts, then shrink back.
SMALLTIDE_KV_INITIAL_TOKENS=32768
# Global KV format:
#   k8v4 = FP8 E4M3 keys + per-32-group asymmetric INT4 values (~472 MiB saved at 128K; recommended)
#   fp8  = FP8 E4M3 keys + FP8 E4M3 values
SMALLTIDE_KV_FMT=k8v4
# Default output token limit when an API request omits `max_tokens` (still bounded by context).
SMALLTIDE_MAX_TOKENS=131072

# --- Expert residency (TideLM) ----------------------------------------------------------------
# Device pool slots: `auto` sizes from the measured on-card resident VRAM budget.
SMALLTIDE_NVFP4_SLOTS=auto
SMALLTIDE_MXFP8_SLOTS=auto
# Keep MXFP8 experts on-card via the resident pool (`off`) instead of PCIe host-mapped (`on`).
SMALLTIDE_MXFP8_HOST=off
# Bound for `auto` pool sizing:
#   resident = only what stays in dedicated GDDR6 VRAM (DXGI budget + bandwidth probe; recommended)
#   device   = HIP free memory (on Windows, excess allocations silently spill to slow system RAM)
SMALLTIDE_POOL_BUDGET=resident
# Safety margins (MiB) kept free so WDDM never demotes dense weights, KV, or pool chunks.
SMALLTIDE_RESIDENT_MARGIN_MB=768
SMALLTIDE_RESIDENT_TAIL_MB=384
# Adrenalin 26.5.1-26.9.1 capped residency near half the card (ROCm/TheRock#7221); on those
# older drivers uncomment the line below:
# SMALLTIDE_RESIDENT_CAP=reservation
# HIP device index (default: auto-selects the discrete GPU with the most VRAM).
# SMALLTIDE_HIP_DEVICE=1
# GPU kernel build (default: the one for the card's architecture, shown by `smalltide.cmd probe`).
# gfx1201 = RX 9070 family / Radeon AI PRO R9700, gfx1200 = RX 9060 family. Only set this if
# probe reports an architecture it has no kernels for.
# SMALLTIDE_KERNEL_ARCH=gfx1201
# Host RAM tier (GiB) holding non-VRAM experts so misses rescue over PCIe (~17 GB/s) instead of NVMe.
# It must hold every expert that is not on the card (about 4.8 MiB each on average) plus some
# headroom; the engine keeps the off-card experts in it and reads strays back in the background.
# 16 holds all 3,072 experts. With the monitor on the motherboard output the desktop's graphics
# memory comes out of system RAM as well: use 10 there (see "Monitor on the card or on the
# motherboard" in the README).
SMALLTIDE_RAM_GB=12

# --- Inline miss rescue -----------------------------------------------------------------------
# What to do when a routed expert is not in VRAM:
#   threshold = rescue only if routing weight >= threshold (else skip + renormalize; recommended)
#   exact     = always copy every missed expert before MoE (highest fidelity, lower tok/s)
#   disabled  = never rescue inline (fastest, relies solely on async promotion)
SMALLTIDE_RESCUE_MODE=threshold
SMALLTIDE_RESCUE_THRESHOLD=0.07
# Separate threshold for the Loop Core layers (each runs 3 times per token).
SMALLTIDE_RESCUE_THRESHOLD_CORE=0.07
# Auto gate (0 or unset = fixed gates). With 1, each block's gate starts at the threshold above and
# is then adjusted while decoding so that the block uses about SMALLTIDE_RESCUE_AUTO_TARGET of its rescue
# budget (below): a block with budget to spare lowers its gate and rescues lighter misses, a block
# over the target raises it. The budgets then set how much time rescues take, so lower them if
# decode gets too slow. The gate stays within SMALLTIDE_RESCUE_AUTO_MIN..SMALLTIDE_RESCUE_AUTO_MAX
# and starts from the threshold again at each server start.
# SMALLTIDE_RESCUE_AUTO_MIN=0 lets the gate fall to 0.1%, which rescues every miss the budgets allow.
SMALLTIDE_RESCUE_AUTO_GATE=1
# SMALLTIDE_RESCUE_AUTO_TARGET=0.8
SMALLTIDE_RESCUE_AUTO_MIN=0.09
# SMALLTIDE_RESCUE_AUTO_MAX=0.5
# Most rescues per decode step in each block (Prelude / Loop Core / Coda):
SMALLTIDE_RESCUE_BUDGET_PRELUDE=25
SMALLTIDE_RESCUE_BUDGET_CORE=24
SMALLTIDE_RESCUE_BUDGET_CODA=30
# GPU-side synchronization for inline rescues:
#   spin      = fused HIP spin-wait + route patch kernel (default, stable & zero host stall)
#   waitvalue = ROCm hipStreamWaitValue32
#   0         = host sync fallback
SMALLTIDE_RESCUE_WAIT=spin
# Rescue rings: an inline rescue copies its expert into the next slot of a ring, and the expert then
# counts as on the card until the ring has gone round. With the default 8 a rescued expert is gone
# within the same step and is copied in again the next time it is routed. A larger ring keeps it:
# 64 slots for the large (MXFP8) experts of the last four layers, where most rescues happen, cost
# about 440 MiB that would otherwise hold resident experts and decoded about 11% faster on the
# RX 9070 XT (128 was slower again). SMALLTIDE_RESCUE_RING_NVFP4 is the ring of the other layers.
SMALLTIDE_RESCUE_RING_MXFP8=8
SMALLTIDE_RESCUE_RING_NVFP4=8

# --- Speculative decoding (DSpark drafter, mtp.safetensors) ----------------------------------
# 1 enables the 3-layer DSpark drafter (~418 MiB VRAM @ 49K ctx) in `run` and single-lane `serve`
# for both greedy (temperature=0) and stochastic (temperature>0) sampling (exact rejection sampling).
SMALLTIDE_SPEC=1
# Fix verify width (2..=8); unset = adaptive confidence-gated draft width.
# SMALLTIDE_SPEC_WIDTH=6

# --- Adaptive expert placement & routing priors ----------------------------------------------
# Routing priors: per-layer routing-share history saved to <SMALLTIDE_MODEL_DIR>/tide_priors.json.
# On a fresh install, SmallTide automatically seeds from `profiles/inkling2-mini-priors.json`
# (aggregate routing floats only) and adapts to your traffic from there. Set `off` to disable.
# SMALLTIDE_PRIORS=models/Inkling-2-Mini/tide_priors.json
# SMALLTIDE_PRIORS_SEED=profiles/inkling2-mini-priors.json
# Set to 0 to freeze priors during controlled benchmarks (`serve` updates by default).
# SMALLTIDE_PRIORS_UPDATE=1
# Prompt-aware async swaps before a request and between prefill chunks:
# SMALLTIDE_ANTICIPATE_SWAPS=256
# SMALLTIDE_PREFILL_CHUNK_SWAPS=96
# SMALLTIDE_ANTICIPATE_WAIT=0
# Prior learning rate and weight:
# SMALLTIDE_PRIORS_NEWEST=0.1
# SMALLTIDE_PRIOR_WEIGHT=0.35
# Resident swap hysteresis (rescue promotion, prefill chunk swaps, post-prefill rebalance):
# SMALLTIDE_SWAP_HYSTERESIS=1.05
# Elastic paged KV: start at this many tokens in VRAM and dynamically grow up to SMALLTIDE_KV_TOKENS
# by borrowing tail NVFP4 expert slots on long prompts (unset = pre-allocate full SMALLTIDE_KV_TOKENS):
# SMALLTIDE_KV_INITIAL_TOKENS=32768
# Speculative verify tail-row rescue decay (0 = exact full-row rescues, 1 = discount tail draft rows):
# SMALLTIDE_SPEC_ROW_DECAY=0
# Decode-time background VRAM promotions & periodic mid-decode rebalance (0 = off; decode uses inline rescues only):
# SMALLTIDE_ASYNC_HYSTERESIS=1.10
# SMALLTIDE_ASYNC_PER_TOKEN=0
# SMALLTIDE_PERIODIC_REBALANCE_SWAPS=0
# Prefill: a missing expert is copied in for a chunk when its routing share summed over the
# chunk reaches this many tokens' worth, else it is skipped and the rest renormalized.
# Unset, it follows the chunk size: 1.0 up to 512-token chunks, 2.0 at 1024.
# SMALLTIDE_PREFILL_MIN_SHARE=2.0
# SMALLTIDE_POOL_CHECK=1

# --- Prefill / server -------------------------------------------------------------------------
# batched (chunks of SMALLTIDE_PREFILL_CHUNK tokens) | token (legacy single-token prefill)
SMALLTIDE_PREFILL=batched
# Tokens per prefill chunk (64 to 1024). Larger chunks prefill faster - every weight is read once
# per chunk - for more scratch VRAM: 1024 costs about 80 resident experts against 256 and
# prefills almost twice as fast.
# SMALLTIDE_PREFILL_CHUNK=1024
# Prefill attention reads the value vectors from a half-precision scratch decoded once per layer
# pass, instead of once per query block (the same numbers, much less work):
#   all   = local and global layers; the global scratch takes 256 bytes per context position
#           and KV head (268 MiB at 128K, about 55 resident experts) and makes a 58K-token
#           prompt read a third faster
#   local = local layers only (4 MiB)
#   0     = off
# SMALLTIDE_ATTN_VTILES=all
# Concurrent serving lanes (all lanes share the SMALLTIDE_KV_TOKENS paged pool).
SMALLTIDE_LANES=2
# SMALLTIDE_LANE_CTX=8192
# Two requests at once are decoded as one batch (0: they take turns, a token each).
# SMALLTIDE_BATCH_DECODE=1
# A batched round rescues missing experts like a draft-verify pass (0: it skips them).
# SMALLTIDE_BATCH_RESCUE=1
# Idle GPU heartbeat in ms (0 = off). With no monitor on the card, Radeon drivers 26.5.1 and
# later put an idle card to sleep after about 10 s and Windows then moves the whole model from
# VRAM into system RAM (ROCm/TheRock#7221); the heartbeat keeps the card awake.
# SMALLTIDE_IDLE_HEARTBEAT_MS=1000
# Experimental: this many GiB of the RAM tier (SMALLTIDE_RAM_GB) in page-locked memory. An expert
# whose RAM copy is page-locked uploads to the card without the copy into the staging buffer
# (2 GiB: about 3% faster decode on a 12K-token prompt). Off by default and capped at 3: this
# driver loses the GPU context (hipError_t=719) above about 6 GB of page-locked memory in all,
# and the prefix cache below uses the same memory. 5 GiB failed in the server.
# SMALLTIDE_RAM_PINNED_GB=0
# Dev switches, both on by default. KEEP_EVICTED_IN_RAM: an expert that a swap takes off the
# card with no RAM copy is read back in the background, and one read from the disk during a
# rescue stays in RAM. STAGE_KICK: a rescued expert's transfer starts while the next one of the
# same layer is still being copied from RAM.
# SMALLTIDE_KEEP_EVICTED_IN_RAM=1
# SMALLTIDE_STAGE_KICK=1
# Prompt prefix cache in pinned host RAM (opt out per request with `"cache_prompt": false`).
# A request resumes from a snapshot: one is taken at the end of each prompt, one at the start of
# its last user message and one after the system prompt. The token budget should hold two or three
# snapshots of the longest conversation: with less, long requests that alternate (an agent's main
# and side requests) evict each other's snapshots and each turn is read again from the start.
# 196,608 tokens holds three of 65K. Page-locked memory when full: about 15 KB per token (2.9 GB)
# plus about 170 MB per snapshot (1.3 GB for 8); see SMALLTIDE_RAM_PINNED_GB above for the limit.
# Unset, it keeps 12 snapshots within 65,536 tokens.
SMALLTIDE_PREFIX_SNAPSHOTS=8
SMALLTIDE_PREFIX_TOKENS=196608
SMALLTIDE_HOST=0.0.0.0
SMALLTIDE_PORT=8000

# --- Diagnostics (leave unset normally) -------------------------------------------------------
# SMALLTIDE_PROFILE=1          # per-section decode timing with syncs (slow)
# SMALLTIDE_SEGTIME=1          # GPU timeline segments per token
# SMALLTIDE_KTIMING=1          # per-kernel event timing
# SMALLTIDE_DUMP_DIR=dump      # per-token layer dumps for tools/inkling2_loop_ref.py
# SMALLTIDE_PREFIX_DEBUG=1     # log prefix-cache decisions in the server
# SMALLTIDE_BENCH_MOE=1        # MoE timing per expert-pool region at `run` startup

# Image input (PNG / JPEG parts in chat requests): the vision tower is streamed from the checkpoint
# per image, nothing of it stays in RAM or VRAM. 0 turns it off; MAX_TOKENS caps one image
# (one token is a 40 x 40 px cell; larger images are scaled down).
# SMALLTIDE_VISION=1
# SMALLTIDE_VISION_MAX_TOKENS=1536
